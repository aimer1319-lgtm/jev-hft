# Vercel AI Gateway key. Required for JEV_PROVIDER=gateway (the default).
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=typesafe-ai/jev

# gateway | typesafe (direct API, lower latency) | mock (free, simulated)
JEV_PROVIDER=gateway
TYPESAFE_AI_API_KEY=

# Round-trip trading cost for analysis: fees + spread for your venue and tier, in bps
FEE_BPS=10

# News path: feeds as name=url pairs (defaults: Fed, CFTC, Coinbase status, CoinDesk, Cointelegraph)
NEWS_FEEDS=
NEWS_POLL_S=30
# Required for sec.gov feeds (SEC fair access policy): "Your Name your-email@example.com"
NEWS_USER_AGENT=

# Alpaca (US stock quotes and news). Free plan: IEX quotes, 30 live symbols.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# iex (free) or sip (paid, all US exchanges)
ALPACA_FEED=iex
# Which news sources to run: rss, alpaca, edgar, x
NEWS_SOURCES=rss,alpaca,edgar,x

# X API (read-only use needs only the bearer token). Billed per post read.
X_BEARER_TOKEN=
# Accounts to follow (default: federalreserve SECGov CFTC USTreasury BLS_gov coinbase)
X_ACCOUNTS=
X_POLL_S=30
X_MAX_POSTS_PER_DAY=500
